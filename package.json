{
  "name": "n8n-nodes-srezai-web-search-pro",
  "version": "1.0.2",
  "description": "n8n community node for AI-agent web access: web search, page reading as Markdown, site maps, schema extraction, fact-check with quotes, deep research and YouTube transcripts. MCP + REST from one key, strong Russian web coverage. | n8n-нода срезAI: веб-поиск, чтение страниц, MCP для ИИ-агентов, извлечение по схеме, проверка фактов, исследование и субтитры YouTube",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "n8n-nodes",
    "n8n-workflow",
    "web-search",
    "search-api",
    "ai-agent",
    "ai-agents",
    "llm",
    "rag",
    "mcp",
    "model-context-protocol",
    "web-scraping",
    "page-reader",
    "site-map",
    "crawler",
    "structured-extraction",
    "fact-check",
    "deep-research",
    "youtube",
    "transcripts",
    "subtitles",
    "russian-search",
    "srezai"
  ],
  "license": "MIT",
  "homepage": "https://srezai.ru",
  "author": {
    "name": "srezai",
    "email": "hello@srezai.ru"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srezai-team/n8n-nodes-srezai-web-search-pro.git"
  },
  "engines": {
    "node": ">=22.16"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SrezaiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Srezai/Srezai.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/srezai-team/n8n-nodes-srezai-web-search-pro/issues"
  }
}
